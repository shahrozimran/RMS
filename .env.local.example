NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
# Set true only when a trusted ingress overwrites x-forwarded-for.
TRUST_PROXY_HEADERS=false
# Optional canonical browser origin when a reverse proxy changes request origin.
# APP_ORIGIN=https://rms.example.com
# Operator CLI only; remove these after provisioning.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
