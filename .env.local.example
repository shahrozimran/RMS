NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
# Server and background worker only. Leave empty to use the existing rule engine.
OPENROUTER_API_KEY=
# Vercel uses its managed IP header when the VERCEL system variable is available.
# On other production hosts set true only if the private ingress replaces
# x-forwarded-for with exactly one verified client address.
TRUST_PROXY_HEADERS=false
# Optional canonical browser origin when a reverse proxy changes request origin.
# APP_ORIGIN=https://rms.example.com
# Operator CLI only; remove these after provisioning.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
